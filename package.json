{
  "name": "yaptap",
  "version": "0.1.0",
  "description": "Push-to-talk voice input s AI transkripcí",
  "type": "module",
  "main": "out/main/index.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "package": "npm run build && electron-builder"
  },
  "build": {
    "extraResources": [
      {
        "from": "assets/tray-idle.png",
        "to": "tray-idle.png"
      },
      {
        "from": "assets/tray-active.png",
        "to": "tray-active.png"
      }
    ],
    "win": {
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dir"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^33.2.1",
    "electron-builder": "^26.8.1",
    "electron-vite": "^2.3.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@jitsi/robotjs": "^0.6.21",
    "loudness": "^0.4.2",
    "openai": "^6.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "screenshot-desktop": "^1.15.3",
    "uiohook-napi": "^1.5.3"
  },
  "overrides": {
    "node-gyp": "^11.2.0"
  }
}
